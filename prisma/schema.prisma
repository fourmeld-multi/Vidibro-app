generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model VibeUser {
  id           String        @id @default(cuid())
  email        String        @unique
  username     String        @unique
  passwordHash String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  drops        SecretDrop[]
  flags        DropFlag[]
  replies      DropReply[]
  sentDMs      DirectMessage[] @relation("SentDMs")
  receivedDMs  DirectMessage[] @relation("ReceivedDMs")

  @@map("vibe_users")
}

model SecretDrop {
  id          String      @id @default(cuid())
  content     String      @db.Text
  authorId    String?
  author      VibeUser?   @relation(fields: [authorId], references: [id], onDelete: SetNull)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  flags       DropFlag[]
  replies     DropReply[]

  @@index([createdAt(sort: Desc)])
  @@map("secret_drops")
}

model DropFlag {
  id        String     @id @default(cuid())
  dropId    String
  drop      SecretDrop @relation(fields: [dropId], references: [id], onDelete: Cascade)
  userId    String
  user      VibeUser   @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      FlagType
  createdAt DateTime   @default(now())

  @@unique([dropId, userId])
  @@map("drop_flags")
}

enum FlagType {
  RED
  GREEN
}

model DropReply {
  id        String     @id @default(cuid())
  dropId    String
  drop      SecretDrop @relation(fields: [dropId], references: [id], onDelete: Cascade)
  authorId  String
  author    VibeUser   @relation(fields: [authorId], references: [id], onDelete: Cascade)
  content   String     @db.Text
  createdAt DateTime   @default(now())

  @@index([dropId, createdAt])
  @@map("drop_replies")
}

model DirectMessage {
  id        String   @id @default(cuid())
  fromId    String
  from      VibeUser @relation("SentDMs", fields: [fromId], references: [id], onDelete: Cascade)
  toId      String
  to        VibeUser @relation("ReceivedDMs", fields: [toId], references: [id], onDelete: Cascade)
  content   String   @db.Text
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([fromId, toId, createdAt])
  @@map("direct_messages")
}
