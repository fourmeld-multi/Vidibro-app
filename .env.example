# Used by docker-compose.yml at build time (Next.js inlines NEXT_PUBLIC_*
# vars into the client bundle, so these must be correct *before* building,
# not just set at container runtime).

# The signaling server's public URL once DNS + Caddy are live, e.g.
# https://signal.vidibro.com — not a raw container name or VPS IP.
NEXT_PUBLIC_SIGNALING_URL=http://localhost:4000

# STUN is fine to leave on Google's public server.
NEXT_PUBLIC_STUN_URL=stun:stun.l.google.com:19302

# Real Coturn (or managed TURN provider) credentials — required for
# production. Without a real TURN relay, users behind symmetric NAT
# (many mobile carriers, some corporate/campus Wi-Fi) cannot connect at all.
NEXT_PUBLIC_TURN_URL=turn:REPLACE_WITH_COTURN_HOST:3478
NEXT_PUBLIC_TURN_USERNAME=REPLACE_ME
NEXT_PUBLIC_TURN_CREDENTIAL=REPLACE_ME

# CORS origin the signaling server accepts connections from — restrict this
# to the real frontend domain in production instead of the default "*".
FRONTEND_ORIGIN=http://localhost:3000
