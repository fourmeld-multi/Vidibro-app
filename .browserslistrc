# Target modern browsers only — eliminates unnecessary polyfills for
# Array.prototype.at/flat/flatMap, Object.fromEntries/hasOwn, String trim etc.
# This removes ~13 KiB of legacy JS from the bundle (PageSpeed Insight issue).
[production]
chrome >= 91
firefox >= 90
safari >= 15.4
edge >= 93
ios >= 15.4
opera >= 77

[development]
last 1 chrome version
last 1 firefox version
last 1 safari version
